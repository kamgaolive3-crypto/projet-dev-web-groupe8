<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # A la racine, servir le SPA (index.html) avant index.php :
    # docker-php.conf force DirectoryIndex "index.php index.html", sinon "/" part dans Laravel.
    DirectoryIndex index.html index.php

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 1. API Laravel + health check : envoye a index.php (front controller)
    RewriteRule ^(api|sanctum)(/|$) index.php [L,QSA]
    RewriteRule ^up/?$ index.php [L,QSA]

    # 2. Fichiers et dossiers reels (bundle React, images, favicon...) : on ne touche rien
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Toute autre route (/Menu, /Panier...) = page React -> index.html (fallback SPA)
    RewriteRule ^ index.html [L]
</IfModule>

# Fichiers internes inaccessibles en direct
<FilesMatch "^(\.ht|\.env|composer\.(json|lock))">
    Require all denied
</FilesMatch>
